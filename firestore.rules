rules_version = '2';

// Deploy with `npm run deploy:rules` (see docs/firebase.md). Do not edit the rules in the console.
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only reach their own users/{uid} tree.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // User-created categories only; the built-in defaults live in the app (DEFAULT_CATEGORIES).
      // Custom ones must use a Firestore auto id (20 chars), which can never collide with a short default id.
      match /categories/{categoryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && categoryId.size() == 20
          && request.resource.data.type in ['expense', 'income']
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        // Categories are archived, never deleted: transactions keep referencing them.
        allow delete: if false;
      }

      match /transactions/{txId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.type in ['expense', 'income']
          && request.resource.data.walletId in ['cash', 'bank', 'ewallet']
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.categoryId is string;
      }

      match /monthlyStats/{month} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
