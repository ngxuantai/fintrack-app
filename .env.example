# Copy to .env.local (gitignored) and fill in. Values come from
# Firebase Console → Project settings → Your apps → Web app config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Account created in Firebase Console → Authentication → Users.
# Bundled into the app: personal builds only.
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=

# Optional
EXPO_PUBLIC_DISPLAY_NAME=Minh Anh
